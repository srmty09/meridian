# Copy to .env and fill in. Never commit the real .env.

HF_TOKEN=your_huggingface_token
REDIS_URL=redis://localhost:6379

ROUTER_MODEL=srmty/meridian
ROUTER_THRESHOLD=0.75
SEMANTIC_THRESHOLD=0.50
QUALITY_THRESHOLD=8.0

# --- optional overrides (sensible defaults in code) ---
# VERIFIER_SIM_MODEL=cross-encoder/stsb-distilroberta-base
# VERIFIER_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# CACHE_TTL_SECONDS=604800        # exact-cache entry lifetime (0 = never expire)
# ROUTER_BLEND_BELOW=0.55         # blend router with keyword heuristic below this confidence
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RETRIEVAL_TOP_K=5
# MODEL_SMALL=Qwen/Qwen3-0.6B:featherless-ai
# MODEL_MEDIUM=Qwen/Qwen3-1.7B:featherless-ai
# MODEL_LARGE=Qwen/Qwen3-8B:featherless-ai
# COST_SMALL=0.00010
# COST_MEDIUM=0.00030
# COST_LARGE=0.00090
